<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
        PR 1: App Sandbox is OFF.
        ScreenCaptureKit + Screen Recording TCC + global hotkeys are
        easier to debug without the sandbox while we are still
        proving the heartbeat. Sandbox + hardened runtime decisions
        belong to the Developer ID / notarization milestone.
    -->
    <key>com.apple.security.app-sandbox</key>
    <false/>
</dict>
</plist>
